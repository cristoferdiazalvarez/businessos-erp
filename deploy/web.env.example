# Web only. Never pass DATABASE_URL or private passwords to the web image/build.
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_API_URL=/api
# Native Render services use API_INTERNAL_HOST and API_INTERNAL_PORT references.
API_INTERNAL_HOST=PRIVATE_API_HOST
API_INTERNAL_PORT=4000
# Docker builds use API_INTERNAL_ORIGIN=http://api:4000 instead.
# Changing proxy targets or NEXT_PUBLIC_API_URL requires rebuilding the web app.
