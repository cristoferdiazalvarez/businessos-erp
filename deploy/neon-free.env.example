# Operator secrets only, after explicitly approving creation of a Neon Free project.
# Pooler URL for API runtime; never expose either URL to the browser.
DATABASE_URL=postgresql://DEMO_ROLE:REPLACE_IN_SECRET_STORE@YOUR-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&sslaccept=strict&connection_limit=1&pool_timeout=15&connect_timeout=15
# Direct URL is for Prisma migration/seed preparation, not browser builds.
DIRECT_DATABASE_URL=postgresql://DEMO_ROLE:REPLACE_IN_SECRET_STORE@YOUR.eu-central-1.aws.neon.tech/neondb?sslmode=require&sslaccept=strict&connect_timeout=15
# Generate new private values when preparing the fictional fixture; do not publish them.
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
