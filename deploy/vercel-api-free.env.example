# New Vercel project only, Root Directory apps/api, personal Hobby account, Node 22.
NODE_ENV=production
WEB_ORIGIN=https://YOUR-WEB-PROJECT.vercel.app
API_ORIGIN=https://YOUR-WEB-PROJECT.vercel.app
COOKIE_SECURE=true
PUBLIC_DEMO_MODE=true
TRUST_PROXY_HOPS=1
DEMO_EMPLOYEE_EMAIL=employee@businessos.demo
# Copy the pooled DATABASE_URL from Neon into API project secrets only.
# Do not configure a fixed PORT: Vercel injects the runtime port.
# No demo password or direct migration connection is needed by the public login button.
