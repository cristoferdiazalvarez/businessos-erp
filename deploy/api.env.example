# API runtime only. Replace placeholders using the hosting provider's secret store.
NODE_ENV=production
PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=https://YOUR_WEB_HOST
API_ORIGIN=https://YOUR_WEB_HOST
DATABASE_URL=postgresql://businessos:REPLACE_IN_SECRET_STORE@PRIVATE_DB_HOST:5432/businessos
COOKIE_SECURE=true
PUBLIC_DEMO_MODE=true
TRUST_PROXY_HOPS=1
# Generate NEW disposable demo passwords on the hosting provider. Never reuse .env.
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
