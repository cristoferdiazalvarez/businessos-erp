# New Vercel project only, Root Directory apps/web, personal Hobby account, Node 22.
NODE_ENV=production
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_DEMO_MODE=true
API_INTERNAL_ORIGIN=https://YOUR-API-PROJECT.vercel.app
# API_INTERNAL_ORIGIN is a build-time proxy destination. Rebuild when it changes.
# Never add DATABASE_URL, DIRECT_DATABASE_URL or passwords to this project.
